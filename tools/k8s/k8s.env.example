# Copy to tools/k8s/k8s.env. Values must match k8s/build-gpu.pod.yaml. k8s.env is gitignored.

# Path to kubeconfig file (cluster credentials). NOT the same as KUBE_CONTEXT.
# KUBECONFIG=/path/to/kubeconfig.yaml

# Optional: context *name* inside that kubeconfig (see: kubectl --kubeconfig=... config get-contexts).
# Do not put a file path here.
# KUBE_CONTEXT=

NAMESPACE=tai-production
POD_NAME=build-gpu
CONTAINER_NAME=build
REMOTE_ROOT=/workspace

# Optional REMOTE_DIR.
# REMOTE_DIR=
